# Maven / build
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Quarkus
.quarkus/

# IDE
.idea/*
!.idea/checkstyle-idea.xml
!.idea/google-java-format.xml
*.iml
.vscode/
.settings/
.project
.classpath

# OS
.DS_Store

# Logs
*.log

# SvelteKit build output copied into the Quarkus jar so one container serves UI + API.
# Generated by `npm --prefix web run build` — see README > Containerization.
src/main/resources/META-INF/resources/

# Single lockfile policy: package-lock.json is authoritative (scripts/run-local.sh
# and the image build use `npm ci`). A stray `pnpm install` regenerates this and it
# has been committed by accident before. Delete this rule if the project moves to pnpm.
web/pnpm-lock.yaml
