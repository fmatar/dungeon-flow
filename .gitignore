# Maven / build
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Quarkus
.quarkus/

# IDE
.idea/*
!.idea/checkstyle-idea.xml
!.idea/google-java-format.xml
*.iml
.vscode/
.settings/
.project
.classpath

# OS
.DS_Store

# Logs
*.log

# SvelteKit build output copied into the Quarkus jar so one container serves UI + API.
# Generated by `npm --prefix web run build` — see README > Containerization.
src/main/resources/META-INF/resources/

# Single lockfile policy: package-lock.json is authoritative (scripts/dungeon.sh
# and the image build use `npm ci`). A stray `pnpm install` regenerates this and it
# has been committed by accident before. Delete this rule if the project moves to pnpm.
web/pnpm-lock.yaml

# Local agent/tooling scratch — not part of the project
.agents/
.codex/

# .claude holds installed third-party skills and local settings, which are not ours to track.
# Git cannot re-include a path whose parent is excluded, so the project's OWN skills are
# un-ignored explicitly, one directory at a time.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/quarkus-svelte-single-container/
!.claude/skills/container-image-arch-verify/
!.claude/skills/quarkus-flow-dsl-patterns/
skills-lock.json
loadtest/
.agent/
.impeccable/
